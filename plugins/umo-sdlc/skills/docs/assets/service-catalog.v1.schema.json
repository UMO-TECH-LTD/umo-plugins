{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umo.dev/schemas/service-catalog.v1.json",
  "title": "UMO Service Catalog v1",
  "type": "object",
  "required": ["schema", "kind", "metadata", "ownership", "interfaces"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "umo.service-catalog/v1"
    },
    "kind": {
      "const": "ServiceCatalog"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "title", "description", "domain", "lifecycle", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": ["experimental", "production", "deprecated", "retired"]
        },
        "type": {
          "type": "string",
          "enum": ["gateway", "api", "worker", "frontend", "library"]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ownership": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "slack": {
          "type": ["string", "null"]
        },
        "oncall": {
          "type": ["string", "null"]
        }
      },
      "anyOf": [
        {
          "required": ["team"]
        },
        {
          "required": ["lead"]
        }
      ],
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "framework": {
          "type": ["string", "null"]
        },
        "packageManager": {
          "type": ["string", "null"]
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": ["string", "null"]
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "interfaces": {
      "type": "object",
      "required": ["provides", "consumes"],
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interfaceItem"
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interfaceItem"
          }
        }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "object",
      "properties": {
        "healthcheck": {
          "type": ["string", "null"]
        },
        "runbook": {
          "type": ["string", "null"]
        },
        "dashboards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "properties": {
        "readNext": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sharpEdges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "interfaceItem": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["name"]
        },
        {
          "required": ["service"]
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
